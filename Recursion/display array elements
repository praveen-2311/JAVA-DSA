class Main {
        String sum(int a[] , int n , int i)
        {
            if(i>=n)
            {
                return "";
            }
            return a[i]+ " " +sum(a,n,i+1);
        }
    public static void main(String[] args) {
        int a[] = {1,2,3,4,5};
       Main m = new Main();
       System.out.println(m.sum(a , 5 , 0));
    }
}
