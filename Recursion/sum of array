class Main {
        int sum(int a[] , int n , int i)
        {
            if(i>=n)
            {
                return 0;
            }
            return a[i]+sum(a,n,i+1);
        }
    public static void main(String[] args) {
        int a[] = {3,1,2};
       Main m = new Main();
       System.out.println(m.sum(a , 3 , 0));
    }
}
