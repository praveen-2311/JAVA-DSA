class Main {
    int zeros(int n)
    {
        if(n<10)
        {
            if(n%10==0)
            {
                return 1;
            }
            else
            {
                return 0;
            }
        }
        if(n%10==0)
        {
            return 1 + zeros(n/10);
        }
        else
        {
            return zeros(n/10);
        }
    }
    public static void main(String[] args)
    {
        Main m = new Main();
        System.out.println(m.zeros(2024053030));
    }
}
