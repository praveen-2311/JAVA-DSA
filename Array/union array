class Main {
    public static void main(String[] args) {
        int[] a = {3,2,4,4,4,5,6,8};
        int[] b = {1,7,7,7,9,10,10};
        int k = 0;
        int n = a.length;
        int m = b.length;
        int[] res = new int[n+m];
        for(int i=0;i<n;i++)
        {
            int flag = 1;
            for(int j=0;j<k;j++)
            {
                if(a[i]==res[j])
                {
                    flag = 0;
                    break;
                }
            }
            if(flag==1)
            {
                res[k] = a[i];
                k++;
            }
        }
         for(int i=0;i<m;i++)
        {
            int flag = 1;
            for(int j=0;j<k;j++)
            {
                if(b[i]==res[j])
                {
                    flag = 0;
                    break;
                }
            }
            if(flag==1)
            {
                res[k] = b[i];
                k++;
            }
        }
        for(int i=0;i<k;i++)
        {
            System.out.print(res[i]+" ");
        }
    }
}
