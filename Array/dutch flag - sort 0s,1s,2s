class Solution {
    public void sort012(int[] arr) {
        // code here
       int left = 0 , mid = 0 , right = arr.length-1;
       while(mid <= right)
       {
           if(arr[mid]==0)
           {
               int temp = arr[mid];
               arr[mid] = arr[left];
               arr[left] = temp;
               mid++;
               left++;
           }
           else if(arr[mid]==1)
           {
               mid++;
           }
           else 
           {
               int t = arr[mid];
               arr[mid] = arr[right];
               arr[right] = t;
               right--;
           }
       }
    }
}
