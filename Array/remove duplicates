class Solution {
    ArrayList<Integer> removeDuplicates(int[] arr) {
        // code here
    ArrayList<Integer> ans = new ArrayList<>();
    
    ans.add(arr[0]);
    
    if(arr.length==0)
    {
        return ans;
    }
    for(int i=1;i<arr.length;i++)
    {
        if(arr[i]!=arr[i-1])
        {
            ans.add(arr[i]);
        }
    }
        return ans;
    }
}
