import java.util.*;
class Main {
    public static void main(String[] args)
    {
        int[] a = {1,3,5,7,9};
        int[] b = {2,4,6,8,10};
        int n1 = a.length;
        int n2 = b.length;
        int[] c = new int[n1+n2];
        int i=0,j=0,k=0;
        while(i<n1 && j<n2)
        {
            if(a[i]<b[j])
            {
                c[k] = a[i];
                i++;
                k++;
            }
            else
            {
                c[k] = b[j];
                j++;
                k++;
            }
        }
        while(i<n1)
        {
            c[k] = a[i];
            i++;
            k++;
        }
        while(j<n2)
        {
            c[k] = b[j];
            j++;
            k++;
        }
        System.out.println(Arrays.toString(c));
    }
} 
