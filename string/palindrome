class Solution {
    boolean isPalindrome(String s) {
        // code here
        char[] ch = s.toCharArray();
        int i=0;
        int j=s.length()-1;
        int flag = 0;
        while(i<=j)
        {
            if(ch[i]!=(ch[j]))
            {
                flag = 1;
                break;
            }
            i++;
            j--;
        }
        if(flag==0)
            {
                return true;
            }
            else
            {
                return false;
                
            }
    }
}
